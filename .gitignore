# Exclude Vivado/Quartus binary outputs & run directories
*.runs/
*.Xil/
*.jou
*.log
*.str
*.cache/
*.hbs
*.hw/
*.ip_user_files/
*.gen/
*.xpr
webtalk*.jou
webtalk*.log
usage_statistics_webtalk.html
vivado*.backup.jou
vivado*.backup.log

# Exclude simulation build outputs
work/
*.wdb/
xsim.dir/
*.vcd

# Allow source files explicitly
!*.v
!*.sv
!*.vhdl
!*.vhd
!*.tcl
!*.xdc
!*.sdc

# ============================================================================
#  LoopBack_Code: everything below is generated by
#  Automation/PowerShell/Build_All.ps1 (or by opening the project in the
#  Vivado/Vitis GUI). None of it is authoritative source: re-running the build
#  from Source/ and Vendor/ recreates all of it. Deliberately more specific
#  than the blanket "*.bit"/"*.bin" the original template used, so a real
#  deliverable like SD_Image/BOOT.BIN can still be tracked.
# ============================================================================

# Disposable working copy of the vendor HDL tree + packaged IP repositories +
# bitstream/XSA outputs + per-stage build logs. See LoopBack_Code/README.md.
LoopBack_Code/Build/

# Vivado project is regenerated from Source/BlockDesign/system_bd.tcl on every
# run (LoopBack_Code/Vivado/Scripts/create_project.tcl); keep the directory
# tracked via .gitkeep but ignore everything Vivado writes into it.
LoopBack_Code/Vivado/Project/*
!LoopBack_Code/Vivado/Project/.gitkeep

# Vitis workspace is regenerated from the XSA + Source/Firmware on every run.
LoopBack_Code/Vitis/Workspace/*
!LoopBack_Code/Vitis/Workspace/.gitkeep

# Per-machine settings (paths, COM ports, JTAG target) - never portable.
# Source/Config/local.settings.template.json is the tracked, portable template.
LoopBack_Code/Source/Config/local.settings.json

# Python bytecode cache (a stray copy shipped in the original zip; regenerated
# on demand, never authoritative).
__pycache__/
*.pyc
