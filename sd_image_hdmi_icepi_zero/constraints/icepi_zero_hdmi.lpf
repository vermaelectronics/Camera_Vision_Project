// icepi_zero_hdmi.lpf - Lattice Diamond physical + timing constraints
// for sd_image_hdmi_top on the IcePi Zero (LFE5U-25F-6BG256C).
//
// Every LOCATE/IOBUF entry below is copied verbatim from the board
// owner's real master LPF (provided in this session) - clk, button[],
// sd_*, led[0:3], and the gpdi_dp[]/gpdi_dn[] HDMI pins are all real,
// confirmed ball assignments, not guesses. This file only includes the
// subset of the master LPF's pins that sd_image_hdmi_top.v actually
// uses (see that file's own header comment) - the master LPF also
// defines usb_tx/rx, gpio[0:27], pi_*, sd_dat[]/sd_cmd/sd_det (SD-bus-
// native aliases of the same physical balls this design already
// constrains via sd_miso/sd_mosi/sd_csn/sd_clk), a 5th LED, a 2nd
// button, gpdi_cec/sck/sda/util/hpd (HDMI CEC/DDC, unused - this design
// has no EDID/CEC support), usb_dp/dn, sdram_*, flash_*, and tp[] -
// none of which this design's top-level module declares as ports, so
// they're intentionally left out here.
//
// IO_TYPE=LVCMOS33 (plain single-ended), not LVCMOS33D: this is the
// third and final GPDI scheme tried for this design (see hdmi_out.v's
// header comment for the full history of all three). The "D" suffix
// tells the tool to verify the P/N sites are the device's actual
// silicon-bonded true/complementary differential pair - both a real
// nextpnr-ecp5 run (this project, OLVDS true-diff) and a real Lattice
// Diamond PAR run (independent per-pin drive, LVCMOS33D) failed that
// check on some of these sites: "cannot place differential IO at
// location PIOB"/"PIOD" and "Differential comp ... is not placed on a
// true pad of the true/complementary pair" respectively. Since this
// design's RTL has no differential relationship between P/N in logic -
// each pad is driven by its own OB from its own independent net (see
// hdmi_out.v) - there's no reason to keep either true- or pseudo-
// differential electrical pairing; plain LVCMOS33 on all 8 pins avoids
// the whole class of failure regardless of which physical pads are or
// aren't diff-capable. Confirmed working by a real Lattice Diamond
// PAR + bitstream build on real IcePi Zero hardware.

SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62
    MASTER_SPI_PORT=ENABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE;

// https://www.latticesemi.com/en/Support/AnswerDatabase/1/9/6/1964
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

// ---------------------------------------------------------------------
// 50 MHz board oscillator - feeds both PLLs directly.
// ---------------------------------------------------------------------
LOCATE COMP "clk" SITE "M1";
IOBUF  PORT "clk" IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk" 50.000000 MHZ;

// PLL-derived clocks. Both are declared explicitly so Diamond's STA
// has an explicit frequency for each rather than leaving anything
// unconstrained - this matters more here than in the sd_uart_top
// project, since pix_clk and shift_clk (from the SAME PLL instance)
// have a timing relationship tmds_serializer.v depends on being
// correctly analyzed; check the Trace report's cross-clock paths
// between these two nets specifically after Map/PAR.
FREQUENCY NET "sys_clk"   20.000000 MHZ;
FREQUENCY NET "pix_clk"   25.000000 MHZ;
FREQUENCY NET "shift_clk" 125.000000 MHZ;

// ---------------------------------------------------------------------
// Reset button (button[0], active-low, pulled up). button[1] is a
// second board button, not read by this design - included here anyway
// since it's a real port on sd_image_hdmi_top.v and Diamond expects
// every port to have a location.
// ---------------------------------------------------------------------
LOCATE COMP "button[0]" SITE "C4";
IOBUF  PORT "button[0]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "button[1]" SITE "C5";
IOBUF  PORT "button[1]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

// ---------------------------------------------------------------------
// SD card, SPI mode. sd_miso/sd_mosi/sd_csn/sd_clk are the SPI-mode
// aliases the master LPF itself defines for the same physical balls as
// sd_dat[0]/sd_cmd/sd_dat[3]/sd_clk (the SD bus's native 4-bit-mode
// names) - using the SPI-mode names/pins directly here since that's
// this design's protocol.
// ---------------------------------------------------------------------
LOCATE COMP "sd_clk"  SITE "P15";
IOBUF  PORT "sd_clk"  IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sd_mosi" SITE "N16";
IOBUF  PORT "sd_mosi" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sd_miso" SITE "P14";
IOBUF  PORT "sd_miso" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sd_csn"  SITE "M14";
IOBUF  PORT "sd_csn"  IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

// ---------------------------------------------------------------------
// LEDs - first 4 of the board's 5 (led[4] is unused by this design).
// ---------------------------------------------------------------------
LOCATE COMP "led[0]" SITE "E13";
IOBUF  PORT "led[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[1]" SITE "D14";
IOBUF  PORT "led[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[2]" SITE "E12";
IOBUF  PORT "led[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[3]" SITE "C13";
IOBUF  PORT "led[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;

// ---------------------------------------------------------------------
// HDMI (GPDI connector) - real ball assignments, confirmed by the
// board owner's master LPF. gpdi_dp/dn[3] = TMDS clock; gpdi_dp/dn[0..2]
// = TMDS data channels (blue/green/red), matching sd_image_hdmi_top.v's
// own port-to-channel mapping exactly. IO_TYPE=LVCMOS33 (not D) on all
// 8 pins - see the header comment above for why.
// ---------------------------------------------------------------------
LOCATE COMP "gpdi_dp[0]" SITE "R13"; // Blue
IOBUF  PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[0]" SITE "T14";
IOBUF  PORT "gpdi_dn[0]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dp[1]" SITE "R15"; // Green
IOBUF  PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[1]" SITE "T15";
IOBUF  PORT "gpdi_dn[1]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dp[2]" SITE "P16"; // Red
IOBUF  PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[2]" SITE "R16";
IOBUF  PORT "gpdi_dn[2]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dp[3]" SITE "R12"; // Clock
IOBUF  PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "gpdi_dn[3]" SITE "T13";
IOBUF  PORT "gpdi_dn[3]" IO_TYPE=LVCMOS33 DRIVE=4;
