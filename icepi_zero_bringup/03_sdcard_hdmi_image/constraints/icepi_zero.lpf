// ============================================================================
// icepi_zero.lpf -- Lattice Physical Constraints for image_display_top
// ----------------------------------------------------------------------------
// clk / button / led / SD-card / GPDI pin-site assignments are all taken
// directly from the IcePi-Zero board's own published LPF
// (gateware/icepi-zero.lpf at https://github.com/cheyao/icepi-zero) -- the
// same source used throughout this repo. SD-card sites match the sibling
// 02_sdcard_text_reader sub-project; GPDI sites match the sibling
// dvp_camera_hdmi_pipeline project.
// ============================================================================

SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 MASTER_SPI_PORT=ENABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE;

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

// ---- 50MHz board reference oscillator -------------------------------------
LOCATE COMP "clk" SITE "M1";
IOBUF  PORT "clk" IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk" 50 MHZ;

// ---- Buttons (active-low, external pull-up per board design) --------------
LOCATE COMP "button[0]" SITE "C4";
IOBUF  PORT "button[0]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "button[1]" SITE "C5";
IOBUF  PORT "button[1]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

// ---- Status LEDs ------------------------------------------------------------
LOCATE COMP "led[0]" SITE "E13";
IOBUF  PORT "led[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[1]" SITE "D14";
IOBUF  PORT "led[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[2]" SITE "E12";
IOBUF  PORT "led[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[3]" SITE "C13";
IOBUF  PORT "led[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[4]" SITE "D13";
IOBUF  PORT "led[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;

// ---- Onboard microSD slot, native SPI-mode pins ----------------------------
LOCATE COMP "sd_sclk" SITE "P15";
IOBUF  PORT "sd_sclk" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "sd_mosi" SITE "N16";
IOBUF  PORT "sd_mosi" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "sd_miso" SITE "P14";
IOBUF  PORT "sd_miso" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "sd_cs_n" SITE "M14";
IOBUF  PORT "sd_cs_n" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
FREQUENCY PORT "sd_sclk" 7 MHZ;

// ---- Native GPDI/TMDS output ------------------------------------------------
// [0]=Blue [1]=Green [2]=Red [3]=Clock -- same sites and IO_TYPE as
// dvp_camera_hdmi_pipeline's dvp_camera_hdmi_top.v (only the "true" (dp)
// side is driven, matching the IcePi-Zero's own reference DVI example).
LOCATE COMP "gpdi_dp[0]" SITE "R13";
IOBUF  PORT "gpdi_dp[0]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dp[1]" SITE "R15";
IOBUF  PORT "gpdi_dp[1]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dp[2]" SITE "P16";
IOBUF  PORT "gpdi_dp[2]" IO_TYPE=LVCMOS33D DRIVE=4;
LOCATE COMP "gpdi_dp[3]" SITE "R12";
IOBUF  PORT "gpdi_dp[3]" IO_TYPE=LVCMOS33D DRIVE=4;
