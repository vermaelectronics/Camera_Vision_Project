// ============================================================================
// icepi_zero.lpf -- Lattice Physical Constraints for usb_mouse_top
// ----------------------------------------------------------------------------
// clk / button / led / UART sites match every other sub-project in this
// collection. USB sites are the board's own real raw-D+/D- host/device
// pins from its published LPF (gateware/icepi-zero.lpf at
// https://github.com/cheyao/icepi-zero) -- port [0] of the two available
// pairs; port [1] (usb_dp[1]/usb_dn[1], sites J16/J15, pulls E14/E11) is
// free for a second device if needed.
// ============================================================================

SYSCONFIG CONFIG_IOVOLTAGE=3.3 COMPRESS_CONFIG=ON MCCLK_FREQ=62 MASTER_SPI_PORT=ENABLE SLAVE_SPI_PORT=DISABLE SLAVE_PARALLEL_PORT=DISABLE;

BLOCK RESETPATHS;
BLOCK ASYNCPATHS;

// ---- 50MHz board reference oscillator -------------------------------------
LOCATE COMP "clk" SITE "M1";
IOBUF  PORT "clk" IO_TYPE=LVCMOS33 PULLMODE=NONE;
FREQUENCY PORT "clk" 50 MHZ;

// ---- Buttons (active-low, external pull-up per board design) --------------
LOCATE COMP "button[0]" SITE "C4";
IOBUF  PORT "button[0]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;
LOCATE COMP "button[1]" SITE "C5";
IOBUF  PORT "button[1]" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

// ---- Status LEDs ------------------------------------------------------------
LOCATE COMP "led[0]" SITE "E13";
IOBUF  PORT "led[0]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[1]" SITE "D14";
IOBUF  PORT "led[1]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[2]" SITE "E12";
IOBUF  PORT "led[2]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[3]" SITE "C13";
IOBUF  PORT "led[3]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;
LOCATE COMP "led[4]" SITE "D13";
IOBUF  PORT "led[4]" IO_TYPE=LVCMOS33 PULLMODE=DOWN DRIVE=4;

// ---- UART debug/data output -------------------------------------------------
LOCATE COMP "uart_txd" SITE "K15";
IOBUF  PORT "uart_txd" IO_TYPE=LVCMOS33 PULLMODE=UP DRIVE=4;

// ---- Raw USB D+/D- (port 0) + switchable pull-down enables -----------------
// PULLMODE=NONE on usb_dp/usb_dn: this design drives its own tri-state
// logic (dp_oe/dn_oe) and relies on usb_pull_dp/usb_pull_dn -- the board's
// own discrete pull resistors -- for the idle-bus pull-downs, not the
// ECP5 pad's internal weak pull.
LOCATE COMP "usb_dp" SITE "F15";
IOBUF  PORT "usb_dp" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "usb_dn" SITE "E16";
IOBUF  PORT "usb_dn" IO_TYPE=LVCMOS33 PULLMODE=NONE DRIVE=4;
LOCATE COMP "usb_pull_dp" SITE "G15";
IOBUF  PORT "usb_pull_dp" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "usb_pull_dn" SITE "H14";
IOBUF  PORT "usb_pull_dn" IO_TYPE=LVCMOS33 DRIVE=4;
