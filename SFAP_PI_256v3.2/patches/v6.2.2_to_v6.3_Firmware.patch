+int aj_blank_thr(const uint32_t *buf, int nsamp)
+{
+	/* median of |I|,|Q| over both channels from a histogram (no sort): 4
+	 * values per sample instant, 0..2048 */
+	static uint32_t hist[2049];
+	uint32_t half, acc = 0;
+	int t, m = 0, thr;
+	double sig;
+	if(!buf || nsamp <= 0) return 0;
+	for(t = 0; t <= 2048; t++) hist[t] = 0;
+	for(t = 0; t < nsamp; t++) {
+		uint32_t w1 = buf[2 * t], w2 = buf[2 * t + 1];
+		hist[mag12(w1)]++; hist[mag12(w1 >> 16)]++;
+		hist[mag12(w2)]++; hist[mag12(w2 >> 16)]++;
+	}
+	half = (uint32_t)(2 * nsamp);                /* half of the 4 nsamp values */
+	for(m = 0; m <= 2048; m++) {
+		acc += hist[m];
+		if(acc >= half) break;
+	}
+	/* Gaussian per component: median |x| = 0.6745 sigma; +0.5: the
+	 * histogram bin's centre */
+	sig = ((double)m + 0.5) / 0.6745;
+	thr = (int)(AJ_BLK_K * sig + 0.999);
+	if(thr < AJ_BLK_MIN) thr = AJ_BLK_MIN;
+	if(thr > 2047) thr = 2047;
+	return thr;
+}
