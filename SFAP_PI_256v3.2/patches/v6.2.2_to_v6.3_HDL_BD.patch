+
+// ============================================================================
+//  gnss_pt_mram -- 16 x 32 simple dual-port RAM (v6.3 excision mask, two
+//  banks of 8 words), registered read like gnss_pt_wram. Distributed RAM.
+// ============================================================================
+module gnss_pt_mram (
+  input             clk,
+  input             we,
+  input      [3:0]  waddr,
+  input      [31:0] wdata,
+  input             re,
+  input      [3:0]  raddr,
+  output reg [31:0] rdata
+);
+  (* ram_style = "distributed" *) reg [31:0] mem [0:15];
+  integer i;
+  initial begin
+    for (i = 0; i < 16; i = i + 1) mem[i] = 32'd0;
+    rdata = 32'd0;
+  end
+  always @(posedge clk) begin
+    if (we) mem[waddr] <= wdata;
+    if (re) rdata <= mem[raddr];
+  end
+endmodule
