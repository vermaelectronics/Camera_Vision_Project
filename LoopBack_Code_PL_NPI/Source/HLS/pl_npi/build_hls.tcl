# ============================================================================
#  build_hls.tcl  --  Vitis HLS 2023.2: pl_npi.cpp -> block-design IP pl_npi
#
#  Builds the pipelined PL-NPI core v2.4 (see pl_npi.cpp: RX2 normalisation,
#  image taps, gated adaptation with a power detector, bypass, make-up gain;
#  v2.4: input DC blocker and two CW notch filters on the output)
#  and packages it as a Vivado IP that Source/BlockDesign/system_bd.tcl
#  instantiates as pl_npi_0, on sys_cpu_clk (100 MHz) between two async
#  AXI-Stream FIFOs.
#
#  Steps
#    1. C simulation, scenarios 1 (CW null), 2 (no jammer, large gamma),
#       3 (bypass), 4 (gated adaptation), 5 (RX2 normalisation), 7 (image
#       taps, 50 dB jammer), 8 (make-up gain), 9 (wideband, informational),
#       10 (DC blocker), 11 (CW notches), 12 (GPS C/A C/N0 with a CW jammer
#       at J/S 30 / 40 dB, without and with the notch; ~1-3 min in csim).
#       Each needs a freshly reset core, so each is a separate csim_design
#       run.
#    2. C synthesis at a 10 ns target, II=1 (one sample per clock).
#    3. Checks the synthesis report: the pipeline must reach the requested II
#       and the estimated clock must not exceed the target. Otherwise the
#       script fails here instead of producing a bitstream that misses timing.
#    4. export_design -> $GNSS_CRPA_IP_REPO/pl_npi (default ../../../Build/ip_repo)
#
#  USAGE (from this directory)
#    vitis_hls -f build_hls.tcl
#
#  OVERRIDES (environment)
#    PL_NPI_CLK_NS=<ns>   HLS clock target, default 10 (sys_cpu_clk, 100 MHz)
#    PL_NPI_II=<n>        pipeline II, default 1 (2 halves the maximum rate
#                         to 50 MS/s: then use gnss_band=2 or 3 only)
#    PL_NPI_SKIP_CSIM=1   skip step 1
#    PL_NPI_EXTRA_DELAY=<n>  pure delay registers in the weight loop,
#                            default 3 (update delay 9 + n samples). They do
#                            NOT shorten any clock: each of the 9 processing
#                            stages must fit in one clock by itself.
#    PL_NPI_STEP_SHIFT=<n>   step reduction 2^-n, default 2
#    PL_NPI_IMG_SHIFT=<n>    extra step reduction of the image taps, default 2
#    PL_NPI_NOTCHES=<n>      CW notch filters compiled in, 0..2, default 2
#                            (1 or 0 = fallback if the notch misses 10 ns;
#                            the firmware reads the number from the core
#                            status and leaves missing notches off)
#
#  OUTPUT
#    $GNSS_CRPA_IP_REPO/pl_npi/component.xml, VLNV antsdr:gnss:pl_npi:2.1
#    $GNSS_CRPA_IP_REPO/pl_npi/pl_npi_csynth.rpt
#
#  SUCCESS MARKER
#    Prints "PL_NPI_HLS: PASS" only after the IP has been copied.
# ============================================================================

set here [file normalize [file dirname [info script]]]
set work [file join $here build]
if {[info exists ::env(GNSS_CRPA_IP_REPO)]} {
  set ip_repo [file normalize $::env(GNSS_CRPA_IP_REPO)]
} else {
  set ip_repo [file normalize [file join $here .. .. .. Build ip_repo]]
}
set out_ip [file join $ip_repo pl_npi]

# v2.3: the core runs on sys_cpu_clk (100 MHz) behind two clock-crossing
# FIFOs, NOT on the AD9361 l_clk, whose rate follows the sample rate (245.76
# MHz at 61.44 MS/s). One sample per clock is 100 MS/s, more than the AD9361
# can deliver, so the FIFOs never fill.
set clk_period 10
if {[info exists ::env(PL_NPI_CLK_NS)]} { set clk_period $::env(PL_NPI_CLK_NS) }
set pipeline_ii 1
if {[info exists ::env(PL_NPI_II)]} { set pipeline_ii $::env(PL_NPI_II) }
set clk_uncertainty 1.0
puts "PL_NPI_HLS: HLS clock target $clk_period ns (uncertainty $clk_uncertainty ns), II=$pipeline_ii"

file mkdir $work

# ---- source with the requested II -------------------------------------------
set fh  [open [file join $here pl_npi.cpp] r]
set src [read $fh]
close $fh
if {[regsub {#pragma HLS PIPELINE II=1} $src "#pragma HLS PIPELINE II=$pipeline_ii" src] != 1} {
  puts "PL_NPI_HLS: FAIL - expected one '#pragma HLS PIPELINE II=1' in pl_npi.cpp"
  exit 1
}
set hls_src [file join $work pl_npi_hls.cpp]
set fh [open $hls_src w]
puts -nonewline $fh "// GENERATED by build_hls.tcl from pl_npi.cpp -- do not edit.\n// Only the PIPELINE II may differ.\n$src"
close $fh

# ---- HLS project --------------------------------------------------------------
cd $work
open_project -reset pl_npi_hls
set_top pl_npi
set defs ""
foreach v {PL_NPI_EXTRA_DELAY PL_NPI_STEP_SHIFT PL_NPI_IMG_SHIFT PL_NPI_NOTCHES} {
  if {[info exists ::env($v)]} { append defs " -D$v=$::env($v)" }
}
if {$defs ne ""} { puts "PL_NPI_HLS: defines$defs" }
add_files $hls_src -cflags "-I$here$defs"
add_files -tb [file join $here testbench.cpp] -cflags "-I$here$defs -Wno-unknown-pragmas"
open_solution -reset sol -flow_target vivado
set_part {xc7z020clg400-2}
create_clock -period $clk_period -name default
set_clock_uncertainty $clk_uncertainty

# ---- 1 C simulation -------------------------------------------------------------
if {![info exists ::env(PL_NPI_SKIP_CSIM)] || $::env(PL_NPI_SKIP_CSIM) eq "0"} {
  # scenario 12 (GPS C/N0) takes 15+ min in the unoptimised HLS debug binary and
  # only measures the notch benefit; Tests/run_regression.sh runs it in seconds.
  # PL_NPI_CSIM_GPS=1 adds it here.
  set scens {1 2 3 4 5 7 8 9 10 11}
  if {[info exists ::env(PL_NPI_CSIM_GPS)] && $::env(PL_NPI_CSIM_GPS) eq "1"} { lappend scens 12 }
  foreach scen $scens {
    puts "PL_NPI_HLS: csim scenario $scen"
    if {[catch {csim_design -argv $scen} err]} {
      puts "PL_NPI_HLS: FAIL - C simulation scenario $scen: $err"
      exit 1
    }
  }
}

# ---- 2 C synthesis ---------------------------------------------------------------
csynth_design

# ---- 3 report checks -------------------------------------------------------------
set rpt_xml [file join $work pl_npi_hls sol syn report csynth.xml]
set rpt_txt [file join $work pl_npi_hls sol syn report pl_npi_csynth.rpt]
if {![file exists $rpt_xml]} {
  puts "PL_NPI_HLS: FAIL - synthesis report $rpt_xml not found"
  exit 1
}
set fh [open $rpt_xml r]
set xml [read $fh]
close $fh

set est ""
regexp {<EstimatedClockPeriod>([0-9.]+)</EstimatedClockPeriod>} $xml -> est
set ii ""
if {![regexp {<PipelineInitiationInterval>([0-9]+)</PipelineInitiationInterval>} $xml -> ii]} {
  regexp {<Interval-min>([0-9]+)</Interval-min>} $xml -> ii
}
puts "PL_NPI_HLS: estimated clock period $est ns (target $clk_period ns), achieved II $ii (requested $pipeline_ii)"
if {$est eq "" || $est > $clk_period} {
  puts "PL_NPI_HLS: FAIL - estimated clock period '$est' ns exceeds the $clk_period ns target"
  exit 1
}
if {$ii eq "" || $ii > $pipeline_ii} {
  puts "PL_NPI_HLS: FAIL - achieved II '$ii' is worse than the requested $pipeline_ii"
  exit 1
}

# ---- 4 package as a Vivado IP ------------------------------------------------------
export_design -format ip_catalog -rtl verilog \
  -vendor antsdr -library gnss -version 2.1 -ipname pl_npi \
  -display_name "PL-NPI power inversion" \
  -description "Two-element PL-NPI anti-jam core v2.4 (pipelined NLMS power inversion, Vitis HLS): RX2 normalised to RX1, RX2 weight + 2 image taps adapted in hardware, gated by a power detector (bypass with no jammer), output make-up gain, DC blocker and 2 CW notches on the output. s_axis_x = RX1 and RX2 IQ, m_axis_y = array output IQ."

set impl_dir [file join $work pl_npi_hls sol impl]
set ip_src   [file join $impl_dir ip]
if {![file exists [file join $ip_src component.xml]]} {
  # Some releases leave only the zip; unpack it.
  set zips [glob -nocomplain -directory $impl_dir *.zip]
  if {[llength $zips] == 0} {
    puts "PL_NPI_HLS: FAIL - export_design produced no IP in $impl_dir"
    exit 1
  }
  file delete -force $ip_src
  file mkdir $ip_src
  exec unzip -q -o [lindex $zips 0] -d $ip_src
}
if {![file exists [file join $ip_src component.xml]]} {
  puts "PL_NPI_HLS: FAIL - no component.xml in $ip_src"
  exit 1
}

file mkdir $ip_repo
file delete -force $out_ip
file copy -force $ip_src $out_ip
if {[file exists $rpt_txt]} { file copy -force $rpt_txt $out_ip }

puts "PL_NPI_HLS: IP antsdr:gnss:pl_npi:2.1 -> $out_ip"
puts "PL_NPI_HLS: PASS"
exit 0
