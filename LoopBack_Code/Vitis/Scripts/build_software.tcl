# ============================================================================
#  build_software.tcl   (XSCT script)
#
#  Creates a Vitis platform from the exported XSA and builds the bare-metal
#  application from Source/Firmware.
#
#  Requirement 15 (hardware/software sync): the platform is regenerated from
#  the XSA that the FPGA build just produced, so a hardware change always
#  propagates.  Requirement 14: the workspace it creates is a normal Vitis
#  workspace and opens in the IDE.
#
#  The application sources are ADDED BY REFERENCE where the tool allows it and
#  otherwise linked, so Source/Firmware stays the single authoritative copy
#  (requirement 9).
#
#  This is the build path for Vitis 2023.2 (classic, XSCT). Vitis 2026.1 has
#  no XSCT and uses build_software.py instead; both produce the same ELF from
#  the same Source/Firmware.
#
#  USAGE
#    xsct build_software.tcl <xsa> <workspace> <firmware_src> <elf_out> [defines]
#      [defines]  optional comma-separated build-variant defines without -D,
#                 e.g. GNSS_DEPLOY_AUTO_TX (the SD deployment build). They go
#                 into a generated gnss_build_defines.h in the WORKSPACE copy,
#                 exactly as build_software.py does, never onto Source/.
# ============================================================================

if {$argc < 4} {
  puts "SW_RESULT: FAIL - usage: build_software.tcl <xsa> <workspace> <firmware_src> <elf_out> \[defines\]"
  exit 2
}

set xsa       [file normalize [lindex $argv 0]]
set ws        [file normalize [lindex $argv 1]]
set fw_src    [file normalize [lindex $argv 2]]
set elf_out   [file normalize [lindex $argv 3]]
set defines   {}
if {$argc > 4 && [string trim [lindex $argv 4]] ne ""} {
  foreach d [split [lindex $argv 4] ","] {
    set d [string trim $d]
    if {$d ne ""} { lappend defines $d }
  }
}

# Heap and stack for the Empty Application linker script. The template default
# (8 KB each) is too small for the no-OS AD9361 driver, which allocates its
# PHY state with malloc. 1 MB / 64 KB still ends far below the DMA capture
# buffers (ADC_DDR_BASEADDR = DDR base + 8 MB, gnss_capture at 256 MB).
set heap_size  0x100000
set stack_size 0x10000

set plat_name "e310_gnss_platform"
set app_name  "e310_gnss_app"
set domain    "standalone_ps7_cortexa9_0"

foreach f [list $xsa $fw_src] {
  if {![file exists $f]} {
    puts "SW_RESULT: FAIL - missing input: $f"
    exit 2
  }
}

# Regenerated every run so it can never drift from the XSA or Source/.
file delete -force $ws
file mkdir $ws
setws $ws

# ---- platform --------------------------------------------------------------
puts "SW_STAGE: creating platform from [file tail $xsa]"
if {[catch {
  platform create -name $plat_name -hw $xsa -proc ps7_cortexa9_0 \
                  -os standalone -out $ws -no-boot-bsp
} err]} {
  puts "SW_RESULT: FAIL - platform create"
  puts "SW_ERROR: $err"
  exit 2
}
# The default domain's NAME differs between tool versions: XSCT in Vitis
# 2023.2 calls it "standalone_domain", the 2026 flow "standalone_ps7_cortexa9_0".
# Use whatever this Vitis actually created (the active domain right after
# platform create) instead of assuming one.
if {[catch {set active_domain [string trim [domain active]]}] || $active_domain eq ""} {
  set active_domain "standalone_domain"
}
puts "SW_DOMAIN: $active_domain"
set domain $active_domain

# Console: the firmware prints with putchar/printf, i.e. the BSP stdout. The
# block design enables only UART1 (MIO 12/13), the E310 USB console. Pin
# stdin/stdout to it explicitly instead of trusting the default selection.
set stdio_uart "ps7_uart_1"
if {[catch {
  bsp config stdin  $stdio_uart
  bsp config stdout $stdio_uart
} err]} {
  puts "SW_STDOUT: WARNING could not set $stdio_uart ($err); BSP default kept"
} else {
  puts "SW_STDOUT: $stdio_uart"
}

platform generate

# ---- application -----------------------------------------------------------
puts "SW_STAGE: creating application"
if {[catch {
  app create -name $app_name -platform $plat_name -domain $domain \
             -template "Empty Application(C)"
} err]} {
  puts "SW_RESULT: FAIL - app create"
  puts "SW_ERROR: $err"
  exit 2
}

# Pull in the firmware sources.  importsources copies into the workspace; the
# workspace is a generated, disposable area (Vitis/Workspace), and
# Source/Firmware remains authoritative.  Sync-Firmware.ps1 documents the
# route back if the sources are edited inside the IDE (requirement 67).
puts "SW_STAGE: importing firmware from $fw_src"
importsources -name $app_name -path $fw_src

set src_dir [file join $ws $app_name src]

# ---- build-variant defines -> generated header ------------------------------
set hdr [file join $src_dir gnss_build_defines.h]
if {![file exists $hdr]} {
  puts "SW_RESULT: FAIL - gnss_build_defines.h not found in the imported sources ($src_dir)"
  exit 2
}
set fh [open $hdr w]
puts $fh "/* GENERATED by build_software.tcl -- do not edit. */"
puts $fh "#ifndef GNSS_BUILD_DEFINES_H_"
puts $fh "#define GNSS_BUILD_DEFINES_H_"
puts $fh ""
if {[llength $defines] == 0} {
  puts $fh "/* no build-variant defines */"
} else {
  foreach d $defines {
    if {[string first "=" $d] >= 0} {
      set nv [split $d "="]
      puts $fh "#define [string trim [lindex $nv 0]] [string trim [join [lrange $nv 1 end] "="]]"
    } else {
      puts $fh "#define $d 1"
    }
  }
}
puts $fh ""
puts $fh "#endif /* GNSS_BUILD_DEFINES_H_ */"
close $fh
puts "SW_DEFINES_HEADER: $hdr"
puts "SW_EXTRA_DEFINES: [expr {[llength $defines] ? [join $defines { }] : {(none)}}]"

# ---- heap / stack in the template linker script -----------------------------
set ld [file join $src_dir lscript.ld]
if {[file exists $ld]} {
  set fh [open $ld r]; set txt [read $fh]; close $fh
  set n1 [regsub {(_STACK_SIZE\s*=\s*DEFINED\(_STACK_SIZE\)\s*\?\s*_STACK_SIZE\s*:\s*)0x[0-9A-Fa-f]+} $txt "\\1$stack_size" txt]
  set n2 [regsub {(_HEAP_SIZE\s*=\s*DEFINED\(_HEAP_SIZE\)\s*\?\s*_HEAP_SIZE\s*:\s*)0x[0-9A-Fa-f]+} $txt "\\1$heap_size" txt]
  set fh [open $ld w]; puts -nonewline $fh $txt; close $fh
  puts "SW_LINKER: heap $heap_size (set=$n2), stack $stack_size (set=$n1)"
} else {
  puts "SW_LINKER: WARNING lscript.ld not found in $src_dir; template sizes kept"
}

# The no-OS AD9361 driver needs these to compile for this board.
app config -name $app_name -add define-compiler-symbols XILINX_PLATFORM
app config -name $app_name -add define-compiler-symbols ANTSDR_E310
app config -name $app_name -add include-path $fw_src
# libm: the PS LCMV solver (lcmv_math.c, gnss_lcmv_auto.c) uses sqrt/log10/
# atan2/asin/lrint. The standalone template links only -lxil -lgcc -lc.
app config -name $app_name -add libraries m

puts "SW_STAGE: building"
if {[catch {app build -name $app_name} err]} {
  puts "SW_RESULT: FAIL - app build"
  puts "SW_ERROR: $err"
  exit 2
}

set elf [file join $ws $app_name "Debug" "${app_name}.elf"]
if {![file exists $elf]} {
  set elf [file join $ws $app_name "build" "${app_name}.elf"]
}
if {![file exists $elf]} {
  puts "SW_RESULT: FAIL - build reported success but no ELF was found"
  puts "SW_EVIDENCE: looked in [file join $ws $app_name]"
  exit 2
}

file mkdir [file dirname $elf_out]
file copy -force $elf $elf_out
puts "SW_ELF: $elf_out"
puts "SW_RESULT: PASS"
exit 0
