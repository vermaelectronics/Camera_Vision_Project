From 2aa0a2fc1d7b958661eaf2b73ee5abd69ade40a1 Mon Sep 17 00:00:00 2001
From: antsdr-fw-patch <antsdr-fw-patch@localhost>
Date: Thu, 12 Nov 2026 12:00:00 +0000
Subject: [PATCH] ant: SFAP-PI with 64 frequency bins (SFAP_BINS=64)

Applied by build.sh only when SFAP_BINS=64: gnss_passthrough then has
3 x 64 weight words (0x200..0x4FC) and AJ_INFO 0x40200C09, for the
64-bin sfap_pi core (the size of SFAP-PI v5.0).
---
 library/gnss_passthrough/gnss_passthrough.v | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/library/gnss_passthrough/gnss_passthrough.v b/library/gnss_passthrough/gnss_passthrough.v
index 61b20f1..d18848a 100644
--- a/library/gnss_passthrough/gnss_passthrough.v
+++ b/library/gnss_passthrough/gnss_passthrough.v
@@ -181,7 +181,7 @@
 // crpa6: SFAP-PI FFT size. 7 = 128 bins (default), 6 = 64 bins (SFAP-PI v5.0).
 // Must match SFAP_LOG2N of the sfap_pi core and AJ_LOG2N of the firmware
 // (gnss_sfap_cfg.h); ./build.sh sets all three from SFAP_BINS.
-`define AJ_LOG2N 7
+`define AJ_LOG2N 6
 `define AJ_NBIN  (1 << `AJ_LOG2N)
 `define AJ_NHOP  (1 << (`AJ_LOG2N - 1))
 
