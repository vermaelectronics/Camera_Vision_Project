-  ad_connect axi_ad9361/adc_data_$gnss_ch   gnss_passthrough/adc_data_$gnss_ch
-  ad_connect axi_ad9361/dac_enable_$gnss_ch gnss_passthrough/dac_enable_$gnss_ch
-  ad_connect axi_ad9361/dac_valid_$gnss_ch  gnss_passthrough/dac_valid_$gnss_ch
-  ad_connect gnss_passthrough/dac_data_$gnss_ch axi_ad9361/dac_data_$gnss_ch
+set stap_i 0
+foreach stap_ch {i0 q0 i1 q1} {
