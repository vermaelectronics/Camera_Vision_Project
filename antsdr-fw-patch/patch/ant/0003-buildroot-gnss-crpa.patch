diff --git a/package/gnss-crpa/S95gnss_crpa b/package/gnss-crpa/S95gnss_crpa
new file mode 100755
index 00000000..403d4b2f
--- /dev/null
+++ b/package/gnss-crpa/S95gnss_crpa
@@ -0,0 +1,66 @@
+#!/bin/sh
+#
+# gnss_crpa: SMI-PI v4.9.14 GNSS anti-jam service (antsdr-fw-patch 0003).
+# Starts the RX1/RX2 -> anti-jam -> TX1 retransmission at boot, like the
+# bare-metal firmware did. Talk to it with:  gnss   (Ctrl-D leaves)
+#
+# TX1 IS CONDUCTED, ATTENUATED COAX ONLY -- never an antenna.
+#
+# Not started at boot if /mnt/jffs2/gnss_crpa.disable exists
+# (touch it to keep the board RF-silent after the next reboot).
+
+DAEMON=/usr/bin/gnss_crpa
+PIDFILE=/var/run/gnss_crpa.pid
+
+conf_location() {
+	# Settings (custom band 7, start-up band) go to the QSPI jffs2
+	# partition; without it, to the SD card's FAT partition.
+	grep -q " /mnt/jffs2 " /proc/mounts && return
+	if [ -b /dev/mmcblk0p1 ]; then
+		mkdir -p /mnt/sd
+		grep -q " /mnt/sd " /proc/mounts ||
+			mount -t vfat -o noatime,flush /dev/mmcblk0p1 /mnt/sd 2>/dev/null
+		grep -q " /mnt/sd " /proc/mounts && export GNSS_CRPA_CONF=/mnt/sd/gnss_crpa.conf
+	fi
+}
+
+running() {
+	[ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
+}
+
+case "$1" in
+start)
+	if [ -f /mnt/jffs2/gnss_crpa.disable ] && [ "$2" != "force" ]; then
+		echo "gnss_crpa: not started (/mnt/jffs2/gnss_crpa.disable); '$0 start force' starts it"
+		exit 0
+	fi
+	if running; then
+		echo "gnss_crpa: already running"
+		exit 0
+	fi
+	conf_location
+	printf "Starting gnss_crpa (SMI-PI anti-jam): "
+	if "$DAEMON" -d; then echo "OK"; else echo "FAIL"; fi
+	;;
+stop)
+	printf "Stopping gnss_crpa (TX1 silenced): "
+	if running; then
+		kill "$(cat "$PIDFILE")"
+		i=0
+		while running && [ $i -lt 20 ]; do sleep 0.2; i=$((i + 1)); done
+	fi
+	echo "OK"
+	;;
+restart|reload)
+	"$0" stop
+	"$0" start force
+	;;
+status)
+	if running; then echo "gnss_crpa: running (pid $(cat "$PIDFILE"))"; else echo "gnss_crpa: stopped"; exit 1; fi
+	;;
+*)
+	echo "Usage: $0 {start|stop|restart|status}"
+	exit 1
+esac
+
+exit 0
diff --git a/package/gnss-crpa/gnss-crpa.mk b/package/gnss-crpa/gnss-crpa.mk
new file mode 100644
index 00000000..d15ad867
--- /dev/null
+++ b/package/gnss-crpa/gnss-crpa.mk
@@ -0,0 +1,31 @@
+################################################################################
+#
+# gnss-crpa (antsdr-fw-patch 0003)
+#
+################################################################################
+
+GNSS_CRPA_VERSION = 4.9.14-linux1
+GNSS_CRPA_SITE = $(TOPDIR)/package/gnss-crpa/src
+GNSS_CRPA_SITE_METHOD = local
+GNSS_CRPA_DEPENDENCIES = libiio
+GNSS_CRPA_LICENSE = Proprietary (SMI-PI firmware) / ADI no-OS (BSD-3-Clause)
+
+ifeq ($(BR2_PACKAGE_GNSS_CRPA)$(wildcard $(GNSS_CRPA_SITE)/Makefile),y)
+$(error gnss-crpa: $(GNSS_CRPA_SITE) is empty; build with antsdr-fw-patch/build.sh, which copies the sources there)
+endif
+
+define GNSS_CRPA_BUILD_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) CC="$(TARGET_CC)" \
+		CFLAGS="$(TARGET_CFLAGS)" LDFLAGS="$(TARGET_LDFLAGS)"
+endef
+
+define GNSS_CRPA_INSTALL_TARGET_CMDS
+	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) DESTDIR=$(TARGET_DIR) install
+endef
+
+define GNSS_CRPA_INSTALL_INIT_SYSV
+	$(INSTALL) -D -m 0755 $(GNSS_CRPA_PKGDIR)/S95gnss_crpa \
+		$(TARGET_DIR)/etc/init.d/S95gnss_crpa
+endef
+
+$(eval $(generic-package))
