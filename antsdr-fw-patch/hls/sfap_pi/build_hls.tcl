# ============================================================================
#  build_hls.tcl  --  Vitis HLS 2023.2: sfap_pi.cpp -> block-design IP sfap_pi
#
#  Builds the space-frequency adaptive power-inversion filter (SFAP-PI v5.0,
#  see sfap_pi.cpp) and packages it as a Vivado IP that the E310 block design
#  (plutosdr-fw/hdl/projects/ant/system_bd.tcl, patch 0003) instantiates as
#  sfap_pi_0, in the sys_cpu_clk domain (100 MHz), between two clock-crossing
#  FIFOs.
#
#  Steps
#    1. C simulation, scenarios 1 (accuracy, bypass, saturation), 2 (wideband
#       jammer), 3 (no jammer), 4 (CW jammer), 5 (jammer + reflection), 6 (50 dB
#       jammer with I/Q imbalance), 7 (RX2 25 dB weaker: normalisation), 8
#       (60 dB jammer with I/Q imbalance) and 9 (CW on the satellite).
#       The weights come from the firmware's solver (gnss_crpa/src/
#       gnss_aj_math.c), compiled into the testbench. Each scenario needs a
#       freshly reset core, so each is a separate csim_design run.
#    2. C synthesis at a 10 ns target, II=1 (one sample per clock).
#    3. Checks the synthesis report: the pipeline must reach the requested II
#       and the estimated clock must not exceed the target. Otherwise the
#       script fails here instead of producing a bitstream that misses timing.
#    4. export_design -> $GNSS_CRPA_IP_REPO/sfap_pi
#
#  USAGE (from this directory; normally run by ../../build.sh hls)
#    vitis_hls -f build_hls.tcl
#
#  antsdr-fw-patch crpa6: the core is SFAP-PI v5.0 (SFAP_PassLVDS,
#  Source/HLS/sfap_pi) with the FFT size selectable: SFAP_LOG2N = 7 (128 bins,
#  default) or 6 (64 bins, the v5.0 size).
#
#  OVERRIDES (environment)
#    SFAP_LOG2N=<6|7>     FFT size (build.sh sets it from SFAP_BINS)
#    SFAP_CLK_NS=<ns>     HLS clock target, default 10 (sys_cpu_clk, 100 MHz)
#    SFAP_II=<n>          pipeline II, default 1
#    SFAP_SKIP_CSIM=1     skip step 1
#    GNSS_CRPA_IP_REPO=<dir>  output IP repository
#    SFAP_FW_DIR=<dir>    directory holding gnss_aj_math.c/.h
#
#  OUTPUT
#    $GNSS_CRPA_IP_REPO/sfap_pi/component.xml, VLNV antsdr:gnss:sfap_pi:3.0
#    $GNSS_CRPA_IP_REPO/sfap_pi/sfap_pi_csynth.rpt
#
#  SUCCESS MARKER
#    Prints "SFAP_PI_HLS: PASS" only after the IP has been copied.
# ============================================================================

set here [file normalize [file dirname [info script]]]
set work [file join $here build]
if {[info exists ::env(GNSS_CRPA_IP_REPO)]} {
  set ip_repo [file normalize $::env(GNSS_CRPA_IP_REPO)]
} else {
  set ip_repo [file normalize [file join $here .. .. plutosdr-fw hdl library antsdr_ip]]
}
set out_ip [file join $ip_repo sfap_pi]
# The firmware's weight solver, compiled into the C simulation.
if {[info exists ::env(SFAP_FW_DIR)]} {
  set fw_dir [file normalize $::env(SFAP_FW_DIR)]
} else {
  set fw_dir [file normalize [file join $here .. .. gnss_crpa src]]
}

# v4.0/v4.1: the core runs on sys_cpu_clk (100 MHz) behind two clock-crossing
# FIFOs, NOT on the AD9361 l_clk, whose rate follows the sample rate (245.76
# MHz at 61.44 MS/s). One sample per clock is 100 MS/s, more than the AD9361
# can deliver, so the FIFOs never fill.
set clk_period 10
if {[info exists ::env(SFAP_CLK_NS)]} { set clk_period $::env(SFAP_CLK_NS) }
set pipeline_ii 1
if {[info exists ::env(SFAP_II)]} { set pipeline_ii $::env(SFAP_II) }
set clk_uncertainty 1.0
# FFT size: 7 = 128 bins (default), 6 = 64 bins. build.sh passes SFAP_LOG2N.
set log2n 7
if {[info exists ::env(SFAP_LOG2N)] && $::env(SFAP_LOG2N) ne ""} { set log2n $::env(SFAP_LOG2N) }
if {$log2n != 6 && $log2n != 7} {
  puts "SFAP_PI_HLS: FAIL - SFAP_LOG2N must be 6 or 7 (got '$log2n')"
  exit 1
}
set nbins [expr {1 << $log2n}]
puts "SFAP_PI_HLS: $nbins frequency bins, HLS clock target $clk_period ns (uncertainty $clk_uncertainty ns), II=$pipeline_ii"

file mkdir $work

# ---- source with the requested II -------------------------------------------
set fh  [open [file join $here sfap_pi.cpp] r]
set src [read $fh]
close $fh
if {[regsub {#pragma HLS PIPELINE II=1} $src "#pragma HLS PIPELINE II=$pipeline_ii" src] != 1} {
  puts "SFAP_PI_HLS: FAIL - expected one '#pragma HLS PIPELINE II=1' in sfap_pi.cpp"
  exit 1
}
set hls_src [file join $work sfap_pi_hls.cpp]
set fh [open $hls_src w]
puts -nonewline $fh "// GENERATED by build_hls.tcl from sfap_pi.cpp -- do not edit.\n// Only the PIPELINE II may differ.\n$src"
close $fh

# ---- HLS project --------------------------------------------------------------
cd $work
open_project -reset sfap_pi_hls
set_top sfap_pi
add_files $hls_src -cflags "-I$here -DSFAP_LOG2N=$log2n"
add_files [file join $here sfap_pi.h]
add_files [file join $here sfap_tables.h]
add_files -tb [file join $here testbench.cpp] -cflags "-I$here -I$fw_dir -DSFAP_LOG2N=$log2n -DAJ_LOG2N=$log2n -Wno-unknown-pragmas"
add_files -tb [file join $fw_dir gnss_aj_math.c] -cflags "-I$fw_dir -DAJ_LOG2N=$log2n"
open_solution -reset sol -flow_target vivado
set_part {xc7z020clg400-2}
create_clock -period $clk_period -name default
set_clock_uncertainty $clk_uncertainty

# ---- 1 C simulation -------------------------------------------------------------
if {![info exists ::env(SFAP_SKIP_CSIM)] || $::env(SFAP_SKIP_CSIM) eq "0"} {
  foreach scen {1 2 3 4 5 6 7 8 9} {
    puts "SFAP_PI_HLS: csim scenario $scen"
    if {[catch {csim_design -argv $scen} err]} {
      puts "SFAP_PI_HLS: FAIL - C simulation scenario $scen: $err"
      exit 1
    }
  }
}

# ---- 2 C synthesis ---------------------------------------------------------------
csynth_design

# ---- 3 report checks -------------------------------------------------------------
set rpt_xml [file join $work sfap_pi_hls sol syn report csynth.xml]
set rpt_txt [file join $work sfap_pi_hls sol syn report sfap_pi_csynth.rpt]
if {![file exists $rpt_xml]} {
  puts "SFAP_PI_HLS: FAIL - synthesis report $rpt_xml not found"
  exit 1
}
set fh [open $rpt_xml r]
set xml [read $fh]
close $fh

set est ""
regexp {<EstimatedClockPeriod>([0-9.]+)</EstimatedClockPeriod>} $xml -> est
set ii ""
if {![regexp {<PipelineInitiationInterval>([0-9]+)</PipelineInitiationInterval>} $xml -> ii]} {
  regexp {<Interval-min>([0-9]+)</Interval-min>} $xml -> ii
}
puts "SFAP_PI_HLS: estimated clock period $est ns (target $clk_period ns), achieved II $ii (requested $pipeline_ii)"
if {$est eq "" || $est > $clk_period} {
  puts "SFAP_PI_HLS: FAIL - estimated clock period '$est' ns exceeds the $clk_period ns target"
  exit 1
}
if {$ii eq "" || $ii > $pipeline_ii} {
  puts "SFAP_PI_HLS: FAIL - achieved II '$ii' is worse than the requested $pipeline_ii"
  exit 1
}

# ---- 4 package as a Vivado IP ------------------------------------------------------
export_design -format ip_catalog -rtl verilog \
  -vendor antsdr -library gnss -version 3.0 -ipname sfap_pi \
  -display_name "SFAP power inversion, space-frequency" \
  -description "Two-element space-frequency adaptive power-inversion anti-jam filter (Vitis HLS, SFAP-PI v5.0): $nbins frequency bins (windowed FFT, 50 % overlap, weighted overlap-add), per bin one weight on the normalised RX2 and two image (conjugate) taps; RX2 gain g2, bypass and output make-up gain; weights from the ARM via gnss_passthrough. s_axis_x = RX1 and RX2 IQ, m_axis_y = filtered RX1."

set impl_dir [file join $work sfap_pi_hls sol impl]
set ip_src   [file join $impl_dir ip]
if {![file exists [file join $ip_src component.xml]]} {
  # Some releases leave only the zip; unpack it.
  set zips [glob -nocomplain -directory $impl_dir *.zip]
  if {[llength $zips] == 0} {
    puts "SFAP_PI_HLS: FAIL - export_design produced no IP in $impl_dir"
    exit 1
  }
  file delete -force $ip_src
  file mkdir $ip_src
  exec unzip -q -o [lindex $zips 0] -d $ip_src
}
if {![file exists [file join $ip_src component.xml]]} {
  puts "SFAP_PI_HLS: FAIL - no component.xml in $ip_src"
  exit 1
}

file mkdir $ip_repo
file delete -force $out_ip
file copy -force $ip_src $out_ip
if {[file exists $rpt_txt]} { file copy -force $rpt_txt $out_ip }

puts "SFAP_PI_HLS: IP antsdr:gnss:sfap_pi:3.0 ($nbins bins) -> $out_ip"
puts "SFAP_PI_HLS: PASS"
exit 0
